# Configurações do Banco de Dados (MySQL)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=ibradanet
MYSQL_USER=ibrada_user
MYSQL_PASSWORD=ibrada_password

# Backend (NestJS)
PORT=3001
DATABASE_URL="mysql://ibrada_user:ibrada_password@db:3306/ibradanet"
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# Frontend (Next.js)
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Autenticação (obrigatório, sem valor padrão): gere com `openssl rand -hex 32`
JWT_SECRET=
# Origem do front liberada no CORS do back
FRONTEND_URL="http://localhost:3000"
# Gestor inicial (opcional): criado na subida se ainda não existir.
# A senha segue a regra do cadastro (8+ caracteres, 1 maiúscula, 1 número, 1 especial)
GESTOR_EMAIL=
GESTOR_PASSWORD=
GESTOR_NAME=
